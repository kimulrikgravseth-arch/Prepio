{
  "version": 2,
  "rewrites": [
    { "source": "/interview",         "destination": "/interview.html" },
    { "source": "/session",           "destination": "/session.html" },
    { "source": "/bedriftsbibliotek", "destination": "/bedriftsbibliotek.html" },
    { "source": "/lonnskalkulator",   "destination": "/lonnskalkulator.html" },
    { "source": "/soknadsbrev",       "destination": "/soknadsbrev.html" },
    { "source": "/cv-analyse",        "destination": "/cv-analyse.html" },
    { "source": "/priser",            "destination": "/priser.html" }
  ],
  "headers": [
    {
      "source": "/(.*)\\.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/(.*)\\.(?:js|css|woff2?|png|jpg|ico|svg)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
    }
  ]
}
